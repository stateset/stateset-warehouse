# /etc/stateset-wms/drill.env (mode 0600). A role allowed to CREATE/DROP DATABASE,
# on the same managed server or a separate drill server.
WMS_DRILL_ADMIN_URL=postgres://wms_drill:REPLACE@db.example.internal:5432/postgres?sslmode=require
# An admin API key that exists in the restored data (from app.env).
WMS_DRILL_ADMIN_KEY=REPLACE
