# /etc/stateset-wms/app.env (mode 0600). See docs/production.md, step 3.
# One key per person or service; at least 32 random characters each.
WMS_API_KEYS_JSON={"REPLACE-WITH-A-LONG-RANDOM-SECRET":{"tenant":"your-org","actor":"admin:you","role":"admin"}}
# Optional browser sign-in, MCP hosts and integrations:
# WMS_WORKOS_JSON=...
# WMS_MCP_JSON={"allowed_hosts":["wms.example.com"],"allowed_origins":[]}
# WMS_NATIVE_INTEGRATIONS_JSON=...
