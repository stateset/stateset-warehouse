DATABASE_URL=postgres://warehouse:warehouse@127.0.0.1:5548/warehouse
WMS_BIND=127.0.0.1:8088
# Demo credentials work only in explicit demo mode. Real mode starts empty.
WMS_DEMO=true
# Real mode: JSON object of secret API keys (at least 32 chars) to identities.
# WMS_API_KEYS_JSON={"replace-with-a-long-random-secret":{"tenant":"your-org","actor":"operator:alice","role":"admin"}}
# Roles: viewer, operator, admin, oms. OMS may only submit fulfillment orders/cancel before picking.
# Native connections require real mode and tenant mappings; secrets stay server-side.
# TMS credentials require OperationsWrite. OMS shipment writeback remains held.
# After deploying the companion conditional OMS receiver, opt in on its OMS
# connection with "shipment_writeback":"conditional_v1". The legacy endpoint
# is never used for this writeback. See integrations/stateset-sync-server/.
# WMS_NATIVE_INTEGRATIONS_JSON={"your-org":{"oms":{"base_url":"https://oms.example.com","tenant_id":"your-org","api_key":"replace-with-oms-api-key"},"tms":{"base_url":"https://freight.example.com","tenant_id":"your-freight-org","bearer_token":"replace-with-tms-token"}}}
# Optional proposed WMS event receivers; these are NOT existing OMS/TMS endpoints.
# WMS_OMS_WEBHOOK_URL=https://oms.example.com/integrations/wms/events
# WMS_OMS_WEBHOOK_TOKEN=replace-me
# WMS_TMS_WEBHOOK_URL=https://tms.example.com/integrations/wms/events
# WMS_TMS_WEBHOOK_TOKEN=replace-me
